{
  "name": "hamburgueria-pos",
  "version": "1.0.0",
  "description": "Hamburgueria Cantinho do Sabor – POS desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.hamburgueria.pos",
    "productName": "Hamburgueria POS",
    "icon": "icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "frontend/**"
    ],
    "extraResources": [
      {
        "from": "../pos-backend",
        "to": "pos-backend",
        "filter": [
          "**/*",
          "!env.defaults"
        ]
      },
      {
        "from": "../pos-frontend/dist",
        "to": "pos-frontend/dist"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}