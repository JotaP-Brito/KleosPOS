{
  "name": "hamburgueria-pos",
  "version": "1.1.0",
  "description": "Hamburgueria Cantinho do Sabor – POS desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/prepare-package.js && electron-builder"
  },
  "build": {
    "appId": "com.hamburgueria.pos",
    "productName": "Hamburgueria POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": ".bundle/pos-backend",
        "to": "pos-backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".bundle/pos-frontend/dist",
        "to": "pos-frontend/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
