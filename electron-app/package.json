{
  "name": "hamburgueria-pos",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.hamburgueria.pos",
    "productName": "Hamburgueria POS",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../pos-backend",
        "to": "pos-backend",
        "filter": ["**/*", "!node_modules/**"]
      },
      {
        "from": "../pos-backend/node_modules",
        "to": "pos-backend/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../pos-frontend/dist",
        "to": "pos-frontend/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../pos-frontend/public/images/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hamburgueria POS"
    }
  }
}